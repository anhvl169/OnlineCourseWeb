# Thông tin Database
DB_USER=admin                      # Thay bằng username MSSQL của bạn (thường là sa)
DB_PASSWORD=123456   # Thay bằng password của bạn
DB_SERVER=localhost            # Hoặc IP máy chủ chứa database
DB_NAME=OnlineCoursesDB       # Tên database chứa các bảng User, Roles...

# Thông tin Server Node.js
PORT=5000

# Khóa bí mật dùng cho JWT sau này
JWT_SECRET=demo_jwt_secret_key